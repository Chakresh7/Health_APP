# Copy these keys into local.properties (that file is gitignored).
# 1. Create a Supabase project and enable Google under Authentication → Providers.
# 2. In Google Cloud, create OAuth clients:
#    - Web application (use this client ID in the app and in Supabase Google provider)
#    - Android (package com.calai + debug SHA-1 from gradlew signingReport)
# 3. In Supabase Google provider, add the Web client ID and secret, plus the Android client ID
#    under "Client IDs" / Authorized Client IDs.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
